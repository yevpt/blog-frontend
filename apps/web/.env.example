# Go 后端基础 URL（服务端使用，不暴露给浏览器 JS）
API_BASE_URL=http://localhost:8080

# 博主用户 ID，用于过滤碎语接口
BLOG_USER_ID=1

# Analytics collect token 签名密钥（仅 SSR 服务端使用，禁止暴露给浏览器）。
# 必须与后端 BLOG_ANALYTICS_COLLECT_TOKEN_SECRET 设置为完全相同的值（变量名不同、密钥相同）。
# 留空 / 不设置：前端不签发 token，后端在自身 secret 也为空时放行（开发模式）。
ANALYTICS_COLLECT_TOKEN_SECRET=

# collect token 有效期（毫秒），默认 300000 = 5 分钟，应与后端 analytics.collect_token_ttl（默认 5m）保持一致。
# 注意：SSR 服务器与后端之间的时钟偏移可能导致有效 token 被拒绝（若 SSR 时钟超前）；两端均应启用 NTP 校时。
ANALYTICS_COLLECT_TOKEN_TTL_MS=300000

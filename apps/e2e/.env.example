# 后端地址：本地后端跑 `make dbsetup` 后用 http://localhost:8080；或填测试环境 URL
E2E_BACKEND_API=http://localhost:8080

# 前端本地地址（默认值，一般无需改）
E2E_WEB_BASE_URL=http://localhost:3000
E2E_ADMIN_BASE_URL=http://localhost:5173

# web 登录账号（identifier 支持用户名或邮箱）
E2E_WEB_IDENTIFIER=admin
E2E_WEB_PASSWORD=admin

# admin 登录账号
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=admin

{
  "name": "blog-frontend",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm -r --if-present build",
    "check-types": "pnpm -r --if-present check-types",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "push:verify": "PRE_PUSH_NO_CACHE=1 git push",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --coverage",
    "prepare": "simple-git-hooks && node scripts/sync-skills.cjs"
  },
  "simple-git-hooks": {
    "commit-msg": "node scripts/validate-commit-msg.cjs $1",
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "node scripts/pre-push.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@repo/eslint-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "20.11.15",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "postcss": "^8.5.26",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "undici": "^7.29.0",
    "vitest": "^4.1.11"
  },
  "volta": {
    "node": "24.16.0"
  }
}
